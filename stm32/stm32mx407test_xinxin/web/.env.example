# 本地：cp .env.example .env.local 填值；线上：vercel env add <名字> production
DASHSCOPE_API_KEY=sk-替换成你的
ONENET_TOKEN=version=...&res=products%2F...&et=...&method=sha1&sign=...
ONENET_PRODUCT_ID=WW0f6843I6
ONENET_DEVICE_NAME=humi_temp
PANEL_PASSWORD=换成一串长口令（>=16 位随机）
QWEN_MODEL=qwen-flash        # 实测 0.5s/次、11/11 正确；3.x 系列是思考型，会慢 4~17 倍
QWEN_THINKING=0              # 0=关思考（只对思考型模型有效，qwen-flash 会忽略）
RATE_PER_MIN=20
DAILY_BUDGET=1000
# 可选但强烈建议（serverless 限流必须外部存储）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- 火山引擎 TTS（可选：想用它的音色时就配；不配则用浏览器自带朗读）----
# 控制台：语音技术 → 语音合成 → 应用管理，拿 appid / access_token
# 豆包语音合成 2.0（Vivi 2.0 等 bigtts 音色）走 V3 WebSocket，用新版控制台的 API Key：
VOLC_TTS_API_KEY=
VOLC_TTS_V3_RESOURCE=seed-tts-2.0
# VOLC_TTS_API=auto|v1|v3    # 默认 auto：按音色名自动选通道

VOLC_TTS_APPID=
VOLC_TTS_TOKEN=
VOLC_TTS_CLUSTER=volcano_tts
VOLC_TTS_VOICE=BV001_streaming
# 把控制台里的免费音色贴成 JSON（id/name），面板下拉框就按它列
# 音色清单（JSON 数组，可带 group）。下面这行是火山 21 款免费音色 + 豆包 2.0 的 Vivi 2.0，
# 直接粘到 Vercel 环境变量即可（换成短 id 写法也行，后端会自动试 _streaming 后缀）：
VOLC_TTS_VOICES=[{"id":"BV700_streaming","name":"灿灿","group":"通用场景"},{"id":"BV001_streaming","name":"通用女声","group":"通用场景"},{"id":"BV002_streaming","name":"通用男声","group":"通用场景"},{"id":"BV701_streaming","name":"擎苍","group":"有声阅读"},{"id":"BV119_streaming","name":"通用赘婿","group":"有声阅读"},{"id":"BV102_streaming","name":"儒雅青年","group":"有声阅读"},{"id":"BV113_streaming","name":"甜宠少御","group":"有声阅读"},{"id":"BV115_streaming","name":"古风少御","group":"有声阅读"},{"id":"BV007_streaming","name":"亲切女声","group":"助手·配音·教育"},{"id":"BV056_streaming","name":"阳光男声","group":"助手·配音·教育"},{"id":"BV005_streaming","name":"活泼女声","group":"助手·配音·教育"},{"id":"BV051_streaming","name":"奶气萌娃","group":"助手·配音·教育"},{"id":"BV034_streaming","name":"知性姐姐（双语）","group":"助手·配音·教育"},{"id":"BV033_streaming","name":"温柔小哥","group":"助手·配音·教育"},{"id":"BV021_streaming","name":"东北老铁","group":"方言"},{"id":"BV019_streaming","name":"重庆小伙","group":"方言"},{"id":"BV213_streaming","name":"广西表哥","group":"方言"},{"id":"BV503_streaming","name":"活力女声 Ariana","group":"英语"},{"id":"BV504_streaming","name":"活力男声 Jackson","group":"英语"},{"id":"BV522_streaming","name":"气质女生","group":"日语"},{"id":"BV524_streaming","name":"日语男声","group":"日语"},{"id":"zh_female_vv_uranus_bigtts","name":"Vivi 2.0（多语种/方言）","group":"豆包 2.0（大模型）"}]
