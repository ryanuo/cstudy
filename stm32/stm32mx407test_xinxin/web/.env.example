# 本地：cp .env.example .env.local 填值；线上：vercel env add <名字> production
DASHSCOPE_API_KEY=sk-替换成你的
ONENET_TOKEN=version=...&res=products%2F...&et=...&method=sha1&sign=...
ONENET_PRODUCT_ID=WW0f6843I6
ONENET_DEVICE_NAME=humi_temp
PANEL_PASSWORD=换成一串长口令（>=16 位随机）
QWEN_MODEL=qwen-flash        # 实测 0.5s/次、11/11 正确；3.x 系列是思考型，会慢 4~17 倍
QWEN_THINKING=0              # 0=关思考（只对思考型模型有效，qwen-flash 会忽略）
RATE_PER_MIN=20
DAILY_BUDGET=1000
# 可选但强烈建议（serverless 限流必须外部存储）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 控制台：语音技术 → 语音合成 → 应用管理，拿 appid / access_token

# 直接粘到 Vercel 环境变量即可（换成短 id 写法也行，后端会自动试 _streaming 后缀）：
# ---- 火山 TTS（免费音色，可选；不配就只用浏览器朗读）----
# 控制台：https://console.volcengine.com/speech/service/8 → 语音合成 → 应用里拿 appid / access_token
# 注意：只有传统（小模型）音色能用这个 V1 接口；豆包大模型 2.0 的 *_bigtts（Vivi 2.0）不支持
VOLC_TTS_APPID=
VOLC_TTS_TOKEN=
VOLC_TTS_CLUSTER=volcano_tts
VOLC_TTS_VOICE=BV700_streaming
# 21 款免费音色（把上面 VOLC_TTS_VOICE 换成想要的 id 即可，面板里没有音色清单）：
#   通用场景   BV700_streaming 灿灿 | BV001_streaming 通用女声 | BV002_streaming 通用男声
#   有声阅读   BV701_streaming 擎苍 | BV119_streaming 通用赘婿 | BV102_streaming 儒雅青年
#              BV113_streaming 甜宠少御 | BV115_streaming 古风少御
#   助手/配音/教育  BV007_streaming 亲切女声 | BV056_streaming 阳光男声 | BV005_streaming 活泼女声
#              BV051_streaming 奶气萌娃 | BV034_streaming 知性姐姐-双语 | BV033_streaming 温柔小哥
#   方言       BV021_streaming 东北老铁 | BV019_streaming 重庆小伙 | BV213_streaming 广西表哥
#   英语       BV503_streaming Ariana | BV504_streaming Jackson
#   日语       BV522_streaming 气质女生 | BV524_streaming 日语男声
